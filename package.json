{
  "name": "v2plus",
  "version": "1.0.0",
  "description": "Vue 2 组件框架 - 兼容 Element Plus API 的 UI 组件库",
  "main": "dist/v2plus.umd.js",
  "module": "dist/v2plus.esm.js",
  "unpkg": "dist/v2plus.umd.js",
  "jsdelivr": "dist/v2plus.umd.js",
  "style": "dist/v2plus.css",
  "sideEffects": [
    "*.css",
    "*.scss",
    "dist/**/*.css"
  ],
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "dev": "vite",
    "build": "rollup -c build/rollup.config.js",
    "build:watch": "rollup -c build/rollup.config.js -w",
    "docs:dev": "vite --config docs/vite.config.js",
    "docs:build": "vite build --config docs/vite.config.js"
  },
  "peerDependencies": {
    "vue": "^2.6.0"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "element-ui": "^2.15.14",
    "rollup": "^4.12.0",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-vue": "^5.1.9",
    "sass": "^1.71.0",
    "vite": "^4.5.0",
    "vite-plugin-vue2": "^2.0.3",
    "vue": "2.6.14",
    "vue-router": "^3.6.5",
    "vue-template-compiler": "2.6.14"
  },
  "keywords": [
    "vue2",
    "table",
    "component",
    "ui",
    "element-plus"
  ],
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "prismjs": "^1.30.0"
  }
}
